<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * Copyright © Magenx. All rights reserved.
 *
 * The dataSource name below must stay in step with the `collections` item in
 * etc/di.xml. If they drift the grid quietly falls back to a plain collection
 * and the joined "Links Created" column disappears with no error.
 */
-->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">magenx_auto_link_rule_listing.magenx_auto_link_rule_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>magenx_auto_link_rule_columns</spinner>
        <deps>
            <dep>magenx_auto_link_rule_listing.magenx_auto_link_rule_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Rule</label>
            </button>
        </buttons>
    </settings>

    <dataSource name="magenx_auto_link_rule_listing_data_source"
                component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">rule_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Magenx_AutoProductLinks::rules</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="magenx_auto_link_rule_listing_data_source">
            <settings>
                <requestFieldName>rule_id</requestFieldName>
                <primaryFieldName>rule_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="magenx_auto_link_rule_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">magenx_auto_link_rule_listing.magenx_auto_link_rule_listing.magenx_auto_link_rule_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rule_id }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>

        <column name="rule_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>

        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Rule</label>
            </settings>
        </column>

        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Enabledisable"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Active</label>
            </settings>
        </column>

        <column name="link_type" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="Magenx\AutoProductLinks\Model\Config\Source\LinkType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Fills</label>
            </settings>
        </column>

        <column name="target_strategy" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="Magenx\AutoProductLinks\Model\Config\Source\TargetStrategy"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Chooses By</label>
            </settings>
        </column>

        <column name="sort_order" sortOrder="60">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Priority</label>
            </settings>
        </column>

        <!-- The one number that tells a merchant whether a rule is doing
             anything: a rule matching nothing looks identical to a working one
             without it. Joined in Grid\Collection, so it is not filterable. -->
        <column name="links_written" sortOrder="70">
            <settings>
                <filter>false</filter>
                <sortable>false</sortable>
                <label translate="true">Links Created</label>
            </settings>
        </column>

        <column name="from_date" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Active From</label>
            </settings>
        </column>

        <column name="to_date" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Active To</label>
            </settings>
        </column>

        <actionsColumn name="actions" class="Magenx\AutoProductLinks\Ui\Component\Listing\Column\RuleActions"
                       sortOrder="100">
            <settings>
                <indexField>rule_id</indexField>
                <resizeEnabled>false</resizeEnabled>
            </settings>
        </actionsColumn>
    </columns>
</listing>
